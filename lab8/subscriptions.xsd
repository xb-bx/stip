<xs:schema  xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="subscriptions">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="publication">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element type="xs:string" name="type"/>
                            <xs:element  name="theme">
                                <xs:complexType >
                                    <xs:simpleContent>
                                        <xs:extension base="xs:string">
                                            <xs:attribute type="xs:short" name="id">
                                        </xs:extension>
                                    </xs:simpleContent>
                                </xs:complexType>
                            </xs:element>
                            <xs:element type="xs:string" name="title"/>
                            <xs:element type="xs:string" name="frequency"/>
                            <xs:element name="price">
                                <xs:complexType >
                                    <xs:simpleContent>
                                        <xs:extension base="xs:string">
                                            <xs:attribute type="xs:string" name="currency">
                                        </xs:extension>
                                    </xs:simpleContent>
                                </xs:complexType>
                            </xs:element>
                            <xs:element type="xs:short" name="subscription_index"/>
                         </xs:sequence>
                        <xs:attribute type="xs:string" name="country" use="optional"/>
                    </xs:complexType>
                </xs:element>
             </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
